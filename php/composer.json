        "synonym api",
        "free thesaurus api",
        "word synonyms"
    ],
    "homepage": "https://apiverve.com/marketplace/thesaurus?utm_source=php&utm_medium=referral&utm_content=homepage",
    "support": {
        "email": "hello@apiverve.com",
        "docs": "https://docs.apiverve.com/ref/thesaurus",
